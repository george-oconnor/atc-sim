# OpenAI API key for pilot voice TTS (see README "Pilot voices"). Leave
# blank to fall back to the browser's own speech synthesiser.
OPENAI_API_KEY=

# Error tracking (server, plus browser reports relayed through /api/client-error)
SENTRY_DSN=

# Signs the session cookie. Changing it logs everyone out. Required: the
# app refuses to start without it. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
